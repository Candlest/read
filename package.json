{
  "name": "read",
  "version": "1.0.0",
  "description": "轻量阅读器：学术论文与 CET-6 英语两个独立领域，Markdown 阅读与批注；通过 MCP / CLI / REST 向任意 agent 提供上下文",
  "scripts": {
    "start": "node --no-warnings server.js",

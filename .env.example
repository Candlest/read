# 复制为 .env 后填写
# PaddleOCR 云端 API（https://paddleocr.aistudio-app.com），导入 PDF 后自动解析为 Markdown
PADDLEOCR_TOKEN=
# PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# READ_AUTO_PARSER=paddleocr-cloud

# 远程部署
# HOST=0.0.0.0
# READ_TOKEN=
# READ_PUBLIC_URL=https://read.example.com

# arXiv（国内服务器 PDF 下载较慢，可换成代理地址）
# ARXIV_BASE=https://export.arxiv.org
# ARXIV_PDF_TIMEOUT_MS=1800000
